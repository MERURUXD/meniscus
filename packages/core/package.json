{
  "name": "@meniscus/core",
  "version": "0.1.0",
  "type": "module",
  "license": "MPL-2.0",
  "description": "Zero-dependency pure TypeScript kernel for live-DOM continuous glass morphing.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MERURUXD/meniscus.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/MERURUXD/meniscus#readme",
  "bugs": {
    "url": "https://github.com/MERURUXD/meniscus/issues"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  }
}
