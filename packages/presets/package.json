{
  "name": "@sessile/presets",
  "version": "0.3.2",
  "type": "module",
  "license": "MPL-2.0",
  "description": "Optional interaction presets (morphing menu, segmented pill, drag-merge) built on Sessile.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MERURUXD/sessile.git",
    "directory": "packages/presets"
  },
  "homepage": "https://github.com/MERURUXD/sessile#readme",
  "bugs": {
    "url": "https://github.com/MERURUXD/sessile/issues"
  },
  "exports": {
    ".": "./src/index.ts",
    "./experimental": "./src/entries/experimental.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./experimental": {
        "types": "./dist/entries/experimental.d.ts",
        "default": "./dist/entries/experimental.js"
      }
    }
  },
  "dependencies": {
    "@sessile/core": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  }
}
