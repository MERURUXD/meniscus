{
  "name": "@sessile/react",
  "version": "0.3.0",
  "type": "module",
  "license": "MPL-2.0",
  "description": "Lightweight React bindings for Sessile glass morphing surfaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MERURUXD/sessile.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/MERURUXD/sessile#readme",
  "bugs": {
    "url": "https://github.com/MERURUXD/sessile/issues"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@sessile/core": "workspace:*",
    "@sessile/dom": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
